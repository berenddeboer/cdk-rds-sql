// biome-ignore-all format: ~~ Generated by projen. To modify, edit .projenrc.ts and run "pnpm exec projen".
{
  "assist": {
    "actions": {
      "preset": "recommended"
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "test/**",
      "lambda/**",
      ".projenrc.ts",
      "projenrc/**",
      "!.gitattributes",
      "!.github/dependabot.yml",
      "!.github/workflows/build.yml",
      "!.github/workflows/pull-request-lint.yml",
      "!.github/workflows/release.yml",
      "!.gitignore",
      "!.mergify.yml",
      "!.projen/deps.json",
      "!.projen/files.json",
      "!.projen/tasks.json",
      "!projenrc/tsconfig.json",
      "!tsconfig.dev.json",
      "!tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noShadow": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json"
}
