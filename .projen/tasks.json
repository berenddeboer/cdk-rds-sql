{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "biome": {
      "name": "biome",
      "description": "Runs Biome against the codebase",
      "steps": [
        {
          "execArgs": [
            "biome",
            "check",
            "--no-errors-on-unmatched",
            "--write"
          ],
          "receiveArgs": true
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "build:handler": {
      "name": "build:handler",
      "description": "Bundle the Lambda handler and download the RDS CA certificate",
      "steps": [
        {
          "exec": "mkdir -p src/handler"
        },
        {
          "exec": "esbuild lambda/handler.ts --bundle --platform=node --target=node22 --external:aws-sdk --external:@aws-sdk/* --outfile=src/handler/index.js"
        },
        {
          "exec": "curl --silent -fL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o src/handler/global-bundle.pem"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "execArgs": [
            "jsii-diff",
            "npm:cdk-rds-sql",
            "-k",
            "--ignore-file",
            ".compatignore"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "jsii --silence-warnings=reserved-word"
        },
        {
          "spawn": "copy:handler"
        }
      ]
    },
    "copy:handler": {
      "name": "copy:handler",
      "description": "Copy prebuilt handler asset into lib for packaging",
      "steps": [
        {
          "exec": "mkdir -p lib/handler"
        },
        {
          "exec": "cp src/handler/index.js src/handler/global-bundle.pem lib/handler/"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "integ:deploy:dsql": {
      "name": "integ:deploy:dsql",
      "description": "Deploy the DSQL integration test stack",
      "steps": [
        {
          "exec": "pnpm exec cdk deploy TestRdsSqlDsqlStack --require-approval never"
        }
      ]
    },
    "integ:deploy:mysql:serverless": {
      "name": "integ:deploy:mysql:serverless",
      "description": "Deploy the Aurora Serverless V2 integration test stack",
      "steps": [
        {
          "exec": "pnpm exec cdk deploy TestRdsSqlServerlessV2Stack --context engine=mysql --require-approval never"
        }
      ]
    },
    "integ:deploy:postgresql:serverless": {
      "name": "integ:deploy:postgresql:serverless",
      "description": "Deploy the Aurora Serverless V2 integration test stack",
      "steps": [
        {
          "exec": "pnpm exec cdk deploy TestRdsSqlServerlessV2Stack --require-approval never"
        }
      ]
    },
    "integ:destroy:dsql": {
      "name": "integ:destroy:dsql",
      "description": "Destroy the DSQL integration test stack",
      "steps": [
        {
          "exec": "pnpm exec cdk destroy TestRdsSqlDsqlStack --force"
        }
      ]
    },
    "integ:destroy:serverless": {
      "name": "integ:destroy:serverless",
      "description": "Destroy the Aurora Serverless V2 integration test stack",
      "steps": [
        {
          "exec": "pnpm exec cdk destroy TestRdsSqlServerlessV2Stack --force"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "spawn": "package:js",
          "condition": "node -e \"if (!process.env.CI) process.exit(1)\""
        },
        {
          "spawn": "package-all",
          "condition": "node -e \"if (process.env.CI) process.exit(1)\""
        }
      ]
    },
    "package-all": {
      "name": "package-all",
      "description": "Packages artifacts for all target languages",
      "steps": [
        {
          "spawn": "package:js"
        },
        {
          "spawn": "package:python"
        },
        {
          "spawn": "package:dotnet"
        }
      ]
    },
    "package:dotnet": {
      "name": "package:dotnet",
      "description": "Create dotnet language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--pack-command",
            "pnpm pack",
            "--target",
            "dotnet"
          ]
        }
      ],
      "condition": "dotnet --list-sdks 2>/dev/null | grep -q ."
    },
    "package:js": {
      "name": "package:js",
      "description": "Create js language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--pack-command",
            "pnpm pack",
            "--target",
            "js"
          ]
        }
      ]
    },
    "package:python": {
      "name": "package:python",
      "description": "Create python language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--pack-command",
            "pnpm pack",
            "--target",
            "python"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "build:handler"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true",
        "MIN_MAJOR": "1"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      },
      "steps": [
        {
          "spawn": "build:handler"
        },
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--ci"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "biome"
        }
      ]
    },
    "test:update": {
      "name": "test:update",
      "description": "Update jest snapshots",
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      },
      "steps": [
        {
          "spawn": "build:handler"
        },
        {
          "execArgs": [
            "jest",
            "--updateSnapshot",
            "--passWithNoTests",
            "--ci"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "env": {
        "NODE_OPTIONS": "--experimental-vm-modules"
      },
      "steps": [
        {
          "spawn": "build:handler"
        },
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Typecheck typescript",
      "steps": [
        {
          "exec": "pnpm exec tsc --project tsconfig.dev.json --noEmit"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "pnpm",
            "dlx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--cooldown=3",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@aws-sdk/client-secrets-manager,@aws-sdk/client-ssm,@aws-sdk/dsql-signer,esbuild,exponential-backoff,jsii-diff,jsii-pacmak,mysql2,node-pg-format,projen,source-map-support,ts-node,@types/aws-lambda"
          ]
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        },
        {
          "execArgs": [
            "pnpm",
            "update",
            "@aws-sdk/client-secrets-manager",
            "@aws-sdk/client-ssm",
            "@aws-sdk/dsql-signer",
            "@biomejs/biome",
            "@types/jest",
            "@types/node",
            "@types/pg",
            "commit-and-tag-version",
            "esbuild",
            "exponential-backoff",
            "jest-junit",
            "jest",
            "jsii-diff",
            "jsii-pacmak",
            "jsii-rosetta",
            "jsii",
            "mysql2",
            "node-pg-format",
            "pg",
            "projen",
            "source-map-support",
            "testcontainers",
            "ts-jest",
            "ts-node",
            "typescript",
            "@types/aws-lambda",
            "aws-cdk-lib",
            "constructs",
            "--config.minimum-release-age=4320"
          ]
        },
        {
          "exec": "pnpm exec projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "exec": "jsii -w --silence-warnings=reserved-word"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
